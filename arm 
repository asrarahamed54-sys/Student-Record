#include <LPC21xx.H>
#include <string.h>

/* ---------- LCD PINS ---------- */
#define LCD_RS      (1U << 16)
#define LCD_EN      (1U << 17)
#define LCD_DATA    (0x0FU << 18)

/* ---------- OUTPUT PINS ---------- */
#define MOTOR       (1U << 22)
#define GREEN_LED   (1U << 23)
#define RED_LED     (1U << 24)
#define BUZZER      (1U << 25)

/* ---------- KEYPAD PINS ---------- */
#define ROWS        (0x0FU << 4)
#define COLS        (0x0FU << 10)

/* Change these to your actual credentials */
#define PASSWORD    "1234"
#define RFID_UID    "123456789012"

/* ---------- DELAY ---------- */
void delay_ms(unsigned int ms)
{
    unsigned int i, j;

    for(i = 0; i < ms; i++)
        for(j = 0; j < 6000; j++);
}

/* ---------- UART0: PC TERMINAL ---------- */
void uart0_init(void)
{
    PINSEL0 &= ~0x0FU;
    PINSEL0 |=  0x05U;

    U0LCR = 0x83;
    U0DLL = 98;
    U0DLM = 0;
    U0LCR = 0x03;
    U0FCR = 0x07;
}

void uart0_putc(char ch)
{
    while(!(U0LSR & 0x20U));
    U0THR = ch;
}

void uart0_puts(const char *s)
{
    while(*s)
        uart0_putc(*s++);
}

/* ---------- UART1: EM-18 RFID ---------- */
void uart1_init(void)
{
    PINSEL0 &= ~(0x0FU << 16);
    PINSEL0 |=  (0x05U << 16);

    U1LCR = 0x83;
    U1DLL = 98;
    U1DLM = 0;
    U1LCR = 0x03;
    U1FCR = 0x07;
}

char uart1_getc(void)
{
    while(!(U1LSR & 0x01U));
    return (char)U1RBR;
}

int is_hex(char ch)
{
    if(ch >= '0' && ch <= '9')
        return 1;

    if(ch >= 'A' && ch <= 'F')
        return 1;

    if(ch >= 'a' && ch <= 'f')
        return 1;

    return 0;
}

/* EM-18: collect 12 hexadecimal characters.
   Assumes a 12-character ASCII serial frame. */
void read_rfid(char *uid)
{
    unsigned int i = 0;
    char ch;

    while(i < 12)
    {
        ch = uart1_getc();

        if(is_hex(ch))
            uid[i++] = ch;
    }

    uid[12] = '\0';
}

/* ---------- LCD: 16x2, 4-BIT ---------- */
void lcd_pulse(void)
{
    IO0SET = LCD_EN;
    delay_ms(1);
    IO0CLR = LCD_EN;
    delay_ms(1);
}

void lcd_nibble(unsigned int value)
{
    IO0CLR = LCD_DATA;
    IO0SET = (value & 0x0FU) << 18;
    lcd_pulse();
}

void lcd_send(unsigned char value, int is_data)
{
    if(is_data)
        IO0SET = LCD_RS;
    else
        IO0CLR = LCD_RS;

    lcd_nibble(value >> 4);
    lcd_nibble(value & 0x0F);
    delay_ms(2);
}

void lcd_cmd(unsigned char cmd)
{
    lcd_send(cmd, 0);
}

void lcd_data(unsigned char data)
{
    lcd_send(data, 1);
}

void lcd_string(const char *s)
{
    while(*s)
        lcd_data(*s++);
}

void lcd_goto(unsigned char row, unsigned char col)
{
    if(row == 0)
        lcd_cmd(0x80 + col);
    else
        lcd_cmd(0xC0 + col);
}

void lcd_init(void)
{
    delay_ms(20);

    IO0CLR = LCD_RS | LCD_EN;

    lcd_nibble(0x03);
    delay_ms(5);
    lcd_nibble(0x03);
    delay_ms(2);
    lcd_nibble(0x03);
    lcd_nibble(0x02);

    lcd_cmd(0x28);  /* 4-bit, 2-line */
    lcd_cmd(0x0C);  /* Display ON */
    lcd_cmd(0x06);  /* Cursor increment */
    lcd_cmd(0x01);  /* Clear */
    delay_ms(2);
}

/* ---------- 4x4 MATRIX KEYPAD ---------- */
char keypad_read(void)
{
    unsigned int row, col;

    unsigned int row_pin[4] = {
        0x10U, 0x20U, 0x40U, 0x80U
    };

    const char keys[4][4] = {
        {'1','2','3','A'},
        {'4','5','6','B'},
        {'7','8','9','C'},
        {'*','0','#','D'}
    };

    while(1)
    {
        for(row = 0; row < 4; row++)
        {
            IO0SET = ROWS;
            IO0CLR = row_pin[row];

            delay_ms(2);

            for(col = 0; col < 4; col++)
            {
                if(!(IO0PIN & (1U << (10 + col))))
                {
                    delay_ms(20);

                    while(!(IO0PIN &
                           (1U << (10 + col))));

                    IO0SET = ROWS;

                    return keys[row][col];
                }
            }
        }
    }
}

void get_password(char *pass)
{
    unsigned int i = 0;
    char key;

    while(i < 4)
    {
        key = keypad_read();

        if(key >= '0' && key <= '9')
        {
            pass[i++] = key;
            lcd_data('*');
        }
    }

    pass[4] = '\0';
}

/* ---------- LOCK CONTROL ---------- */
void lock_door(void)
{
    IO0CLR = MOTOR;
}

void unlock_door(void)
{
    IO0SET = MOTOR;
}

void alarm_on(void)
{
    IO0SET = BUZZER;
}

void alarm_off(void)
{
    IO0CLR = BUZZER;
}

void access_denied(void)
{
    IO0SET = RED_LED;
    alarm_on();
    delay_ms(500);
    alarm_off();
    delay_ms(300);
    IO0CLR = RED_LED;
}

/* ---------- MAIN PROGRAM ---------- */
int main(void)
{
    char uid[13];
    char pass[5];
    unsigned int attempts = 0;

    /* GPIO selection for keypad */
    PINSEL0 &= ~(0x0000FF00U | 0x0FF00000U);

    /* GPIO selection for LCD and output devices */
    PINSEL1 &= ~0x000FFFFFU;

    /* Initialize serial interfaces */
    uart0_init();
    uart1_init();

    /* Configure output directions */
    IODIR0 |= LCD_RS | LCD_EN | LCD_DATA |
              MOTOR | GREEN_LED | RED_LED |
              BUZZER | ROWS;

    /* Keypad columns are inputs */
    IODIR0 &= ~COLS;

    IO0SET = ROWS;
    IO0CLR = MOTOR | GREEN_LED | RED_LED | BUZZER;

    lcd_init();
    lock_door();

    uart0_puts("\r\nSmart Bank Locker Started\r\n");

    while(1)
    {
        /* Wait for RFID */
        lcd_cmd(0x01);
        lcd_goto(0, 0);
        lcd_string("Scan RFID Card");

        uart0_puts("Waiting for RFID...\r\n");

        read_rfid(uid);

        uart0_puts("RFID: ");
        uart0_puts(uid);
        uart0_puts("\r\n");

        /* Check RFID */
        if(strcmp(uid, RFID_UID) != 0)
        {
            lcd_cmd(0x01);
            lcd_string("Invalid RFID");

            uart0_puts("Access Denied: RFID\r\n");
            access_denied();

            delay_ms(1000);
            continue;
        }

        /* Authorized card */
        attempts = 0;

        while(attempts < 3)
        {
            lcd_cmd(0x01);
            lcd_string("Enter Password:");
            lcd_goto(1, 0);

            get_password(pass);

            if(strcmp(pass, PASSWORD) == 0)
            {
                lcd_cmd(0x01);
                lcd_string("Access Granted");

                uart0_puts("Access Granted\r\n");

                IO0SET = GREEN_LED;
                IO0CLR = RED_LED;

                unlock_door();
                delay_ms(5000);

                lock_door();
                IO0CLR = GREEN_LED;

                lcd_cmd(0x01);
                lcd_string("Locker Locked");

                uart0_puts("Locker Locked\r\n");
                delay_ms(1500);

                break;
            }
            else
            {
                attempts++;

                lcd_cmd(0x01);
                lcd_string("Wrong Password");
                lcd_goto(1, 0);
                lcd_string("Attempts: ");
                lcd_data('0' + attempts);

                uart0_puts("Wrong Password\r\n");
                access_denied();

                delay_ms(800);
            }
        }

        /* Three failures: lockout */
        if(attempts >= 3)
        {
            lock_door();

            IO0CLR = GREEN_LED;
            IO0SET = RED_LED;

            lcd_cmd(0x01);
            lcd_string("SYSTEM LOCKED");

            uart0_puts("3 failures: LOCKOUT\r\n");

            alarm_on();
            delay_ms(1000);
            alarm_off();

            /* Reset required to exit lockout */
            while(1)
            {
                lock_door();
            }
        }
    }
}